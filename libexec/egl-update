#!/usr/bin/env bash
# Обновляет пакет epic-games-launcher из последнего опубликованного GitHub Release.
#
# Запускается таймером egl-fedora-update.timer от root. Читает SHA256SUMS
# последнего релиза, и если там RPM новее установленного, скачивает его,
# сверяет SHA256 и ставит через dnf.
#
# Использование:
#   egl-update           проверить и установить обновление
#   egl-update --check   только проверить

set -euo pipefail

repo='@UPDATE_REPO@'
package=epic-games-launcher
base_url="https://github.com/$repo/releases/latest/download"
evr_pattern='^[0-9A-Za-z._+~^-]+$'

mode=install
case "${1:-}" in
  --check) mode=check ;;
  "") ;;
  *) echo "Usage: egl-update [--check]" >&2; exit 2 ;;
esac

if [[ $repo == @*@ ]]; then
  echo "egl-update: the update repository was not set when the package was built" >&2
  exit 1
fi

fetch() {
  local url=$1 max_time=$2 output=$3
  curl --fail --silent --show-error --location \
    --proto '=https' --proto-redir '=https' \
    --retry 3 --connect-timeout 15 --max-time "$max_time" \
    --output "$output" "$url"
}

# 1, если $1 новее $2; 0, если равны; -1, если старее (сравнение EVR как в rpm).
evr_compare() {
  rpm --eval "%{lua: local a, b = rpm.ver('$1'), rpm.ver('$2'); print(a > b and 1 or (a == b and 0 or -1))}"
}

installed_evr=$(rpm -q --qf '%{VERSION}-%{RELEASE}' "$package")
[[ $installed_evr =~ $evr_pattern ]] || { echo "egl-update: unexpected installed version: $installed_evr" >&2; exit 1; }

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

sums_status=$(curl --silent --show-error --location \
  --proto '=https' --proto-redir '=https' \
  --retry 3 --connect-timeout 15 --max-time 60 \
  --output "$work_dir/SHA256SUMS" --write-out '%{http_code}' \
  "$base_url/SHA256SUMS")
case $sums_status in
  200) ;;
  404)
    echo "No published releases in $repo yet."
    exit 0
    ;;
  *)
    echo "egl-update: $base_url/SHA256SUMS returned HTTP $sums_status" >&2
    exit 1
    ;;
esac
mapfile -t rpm_lines < <(
  awk -v prefix="$package-" '
    NF == 2 && index($2, prefix) == 1 && $2 ~ /\.x86_64\.rpm$/ && $2 !~ /\// { print }
  ' "$work_dir/SHA256SUMS"
)
if ((${#rpm_lines[@]} != 1)); then
  echo "egl-update: expected one $package RPM in SHA256SUMS, found ${#rpm_lines[@]}" >&2
  exit 1
fi
read -r rpm_sha256 rpm_file <<<"${rpm_lines[0]}"
[[ $rpm_sha256 =~ ^[0-9a-f]{64}$ ]] || { echo "egl-update: invalid checksum in SHA256SUMS" >&2; exit 1; }

latest_evr=${rpm_file#"$package-"}
latest_evr=${latest_evr%.x86_64.rpm}
[[ $latest_evr =~ $evr_pattern ]] || { echo "egl-update: unexpected file name in the release: $rpm_file" >&2; exit 1; }

if (($(evr_compare "$latest_evr" "$installed_evr") <= 0)); then
  echo "Up to date: installed $installed_evr, latest release $latest_evr."
  exit 0
fi

if [[ $mode == check ]]; then
  echo "Update available: $installed_evr -> $latest_evr."
  exit 0
fi

echo "Downloading $rpm_file."
fetch "$base_url/$rpm_file" 1800 "$work_dir/$rpm_file"
(cd "$work_dir" && printf '%s  %s\n' "$rpm_sha256" "$rpm_file" | sha256sum --check --quiet)
rpm --checksig --nosignature "$work_dir/$rpm_file" >/dev/null
[[ $(rpm -qp --qf '%{NAME}' "$work_dir/$rpm_file") == "$package" ]] || {
  echo "egl-update: $rpm_file is not the $package package" >&2
  exit 1
}

dnf upgrade --assumeyes "$work_dir/$rpm_file"
echo "Installed update $installed_evr -> $latest_evr."
